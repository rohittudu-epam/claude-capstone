# Database Configuration
POSTGRES_USER=linknote
POSTGRES_PASSWORD=linknote_password
POSTGRES_DB=linknote
DATABASE_URL=postgresql://linknote:linknote_password@postgres:5432/linknote

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth Service
AUTH_SERVICE_URL=http://auth-service:8000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost

# Link Suggestion Configuration
LINK_SUGGESTION_THRESHOLD=0.30
LINK_SUGGESTION_MIN_KEYWORDS=3

# Logging Configuration
LOG_LEVEL=INFO
DEBUG=false

# Traefik Configuration
TRAEFIK_API_INSECURE=true
