# Copy to .env and adjust. Never commit .env.

# --- Runtime -----------------------------------------------------------------
# "production" makes the services refuse the placeholder JWT secret below.
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=linknote
POSTGRES_PASSWORD=linknote_password
POSTGRES_DB=linknote

# --- Authentication ----------------------------------------------------------
# Required. At least 32 characters; generate one with:  openssl rand -hex 32
# Every service that validates tokens receives this same value.
#
# CRITICAL: NEVER use the placeholder value below in production!
# The application will refuse to start in production mode with this placeholder.
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Browsers only keep Secure cookies over HTTPS (localhost excepted). Keep true in production.
COOKIE_SECURE=false

# --- Link suggestions --------------------------------------------------------
# Weighted keyword overlap (0-1) a pair of notes must reach, the minimum number of shared
# keywords, and the most suggestions kept per note. See backend/link-service/link_service/similarity.py.
LINK_SUGGESTION_THRESHOLD=0.30
LINK_SUGGESTION_MIN_SHARED_KEYWORDS=2
LINK_SUGGESTION_MAX_PER_NOTE=10

# --- Graph -------------------------------------------------------------------
# The graph API returns at most this many notes (most recently updated first) and says when it caps.
GRAPH_MAX_NODES=500

# --- Frontend ----------------------------------------------------------------
# Port for the frontend service (default: 3000)
FRONTEND_PORT=3000
# Base URL for API calls from the browser (default: http://localhost for local development)
NEXT_PUBLIC_API_BASE_URL=http://localhost

# --- Seed Data ---------------------------------------------------------------
# Automatically seed demo data on fresh start (true for development, false for production)
SEED_ON_START=true
# Demo account credentials (development only - never use in production)
SEED_DEMO_EMAIL=demo@linknote.local
SEED_DEMO_PASSWORD=demo123456
